# Directories
alias projects='cd $PROJECTS'
alias eventy='cd $PROJECTS/pacholikdev/eventy'
alias wodcomp='cd $PROJECTS/pacholikdev/wodcomp'

# SSH
alias snowy-dust="ssh forge@49.13.172.230"

# PHP
alias phpunit="vendor/bin/phpunit"
alias a="php artisan"
alias ap="php artisan play"
alias ar="php artisan remote"
alias cc="claude"
alias ccc="claude-yolo"
alias cu="composer update"
alias cr="composer require"
alias ci="composer install"
alias cda="composer dump-autoload -o"
alias hostfile="sudo vi /etc/hosts"
alias deploy='scotty run deploy'
alias deploy-code='scotty run deploy-code'
alias mfs='php artisan migrate:fresh --seed'
alias nah='git reset --hard;git clean -df'
alias cq='vendor/bin/code-quality'

alias pp="./vendor/bin/pest --parallel"
alias pt="./vendor/bin/pest --parallel --tia"
alias sshconfig="vi ~/.ssh/config"
alias copykey='command cat ~/.ssh/id_ed25519.pub 2>/dev/null || command cat ~/.ssh/id_rsa.pub 2>/dev/null | pbcopy'
alias tunnel='valet share -subdomain=freekmurze -region=eu'
alias rmf='rm -rf'

# JavaScript
alias jest="./node_modules/.bin/jest"

# Git
alias gpo="git push origin"
alias push="git push"
alias pull="git pull"
alias uncommit="git reset --soft HEAD~1"

# Fast open
alias o="open ."

# List all files colorized in long format
alias l="ls -laF"

# Sublime Text
alias subl='open -a "/Applications/Sublime Text.app"'

# PhpStorm
alias phpstorm='open -a ~/Applications/PhpStorm.app "`pwd`"'

# VS Code
alias vscode='code "`pwd`"'

# Zed
alias zed='open -a /Applications/Zed.app "`pwd`"'

# Redis
alias flush-redis="redis-cli FLUSHALL"

# Show/hide hidden files in Finder
alias show="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
alias hide="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"

# IP addresses
alias ip="curl ifconfig.me/ip ; echo"
alias localip="ifconfig -a | grep -o 'inet6\? \(addr:\)\?\s\?\(\(\([0-9]\+\.\)\{3\}[0-9]\+\)\|[a-fA-F0-9:]\+\)' | awk '{ sub(/inet6? (addr:)? ?/, \"\"); print }'"

# Flush Directory Service cache
alias flushdns="sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"

# Enable aliases to be sudo’ed
alias sudo='sudo '

# Modern CLI tool aliases (conditional on installation)
if command -v eza &> /dev/null; then
    # Conductor's terminal can't render eza's Nerd Font file icons (they show as
    # tofu boxes), so drop --icons there. Other terminals keep the icons.
    if [[ "$__CFBundleIdentifier" == "com.conductor.app" || -n "$CONDUCTOR_INTERNAL_BIN_DIR" ]]; then
        eza_icons=""
    else
        eza_icons="--icons"
    fi
    alias ls="eza $eza_icons --group-directories-first"
    alias l="eza -la $eza_icons --group-directories-first --hyperlink"
    alias ll="eza -l $eza_icons --group-directories-first --hyperlink"
    alias lt="eza --tree --level=2 $eza_icons"
    unset eza_icons
fi

if command -v bat &> /dev/null; then
    alias cat="bat --style=plain"
fi

if command -v rg &> /dev/null; then
    alias grep="rg"
fi

if command -v bottom &> /dev/null; then
    alias htop="btm"
    alias top="btm"
fi
