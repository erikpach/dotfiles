[core]
	excludesfile = ~/.global-gitignore
	autocrlf = false
	pager = delta

[user]
	name = Erik Pach
	email = erik@pacholik.dev
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPevDXEJlURBeAFBG0I9yeD3Kw40il4h1AEt7+nHeapJ

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[fetch]
	prune = true

[pull]
	rebase = false

[init]
	defaultBranch = main

[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

[commit]
	gpgsign = false

[push]
	autoSetupRemote = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
	side-by-side = true
	line-numbers = true

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default
