#!/bin/bash
#
# Standalone Claude Code installation script
# Can be run independently or as part of full dotfiles setup

set -e

# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

step() { echo ""; echo -e "${BLUE}➜${NC} $1"; }
success() { echo -e "${GREEN}✓${NC} $1"; }
warn() { echo -e "${YELLOW}⚠${NC} $1"; }
error() { echo -e "${RED}✗${NC} $1"; exit 1; }

echo ""
echo "Claude Code Installation"
echo "========================"
echo ""

# Install Claude Code
step "Installing Claude Code CLI"
if command -v claude &>/dev/null; then
    warn "Claude Code already installed"
else
    # Try Homebrew first (modern)
    if command -v brew &>/dev/null; then
        brew install --cask claude-code || warn "Claude Code installation failed"
    else
        # Fallback to curl installer
        warn "Homebrew not found, using curl installer"
        curl -fsSL https://claude.ai/install.sh | bash || warn "Claude Code installation failed"
    fi
fi
success "Claude Code processed"

# Check if running from dotfiles repo
DOTFILES_DIR="$HOME/.dotfiles"
if [ ! -d "$DOTFILES_DIR" ]; then
    # Try to detect if script is in a dotfiles directory
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "$SCRIPT_DIR/../config/claude/CLAUDE.md" ]; then
        DOTFILES_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
    fi
fi

# Claude configuration
# Two separate config directories so personal and company accounts have
# isolated auth/credentials while sharing the same dotfiles configuration.
CLAUDE_CONFIG_DIRS=(
    "$HOME/.claude"
    "$HOME/.claude-company"
)

configure_claude_dir() {
    local target_dir="$1"
    local source_dir="$DOTFILES_DIR/config/claude"

    step "Setting up Claude Code configuration in $target_dir"
    mkdir -p "$target_dir"

    ln -sf "$source_dir/CLAUDE.md" "$target_dir/CLAUDE.md"
    ln -sf "$source_dir/laravel-php-guidelines.md" "$target_dir/laravel-php-guidelines.md"
    ln -sf "$source_dir/settings.json" "$target_dir/settings.json"
    ln -sf "$source_dir/statusline.sh" "$target_dir/statusline.sh"

    rm -rf "$target_dir/skills"
    ln -sf "$source_dir/skills" "$target_dir/skills"

    rm -rf "$target_dir/agents"
    ln -sf "$source_dir/agents" "$target_dir/agents"

    success "Configured $target_dir"
}

if [ -d "$DOTFILES_DIR/config/claude" ]; then
    for dir in "${CLAUDE_CONFIG_DIRS[@]}"; do
        configure_claude_dir "$dir"
    done
else
    warn "Dotfiles directory not found, skipping configuration"
    echo "  To set up configuration later, clone dotfiles to ~/.dotfiles"
fi

# Agent Skills (included in dotfiles)
# All skills are version-controlled in config/claude/skills/
# No need to install them - they're symlinked from the dotfiles repo

# Done
echo ""
success "Claude Code setup complete!"
echo ""
step "Next steps:"
if [ ! -d "$DOTFILES_DIR/config/claude" ]; then
    echo "  • Clone dotfiles for custom configuration:"
    echo "    git clone https://github.com/freekmurze/dotfiles.git ~/.dotfiles"
    echo "    ~/.dotfiles/bin/install-claude-code"
    echo ""
fi
echo "  • Start using personal account: claude"
echo "  • Start using company account: CLAUDE_CONFIG_DIR=~/.claude-company claude"
echo "  • Discover more skills: https://skills.sh"
echo ""
