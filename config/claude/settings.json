{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "150000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "250000",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "Skill(ray-skill:*)",
      "Skill(php-guidelines-from-spatie:*)",
      "Skill(fix-github-issue:*)",
      "Skill(context7-auto-research:*)",
      "Skill(readability:*)",
      "Skill(agent-browser:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(composer:*)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(vendor/bin/pest:*)",
      "Bash(git:*)",
      "Bash(php artisan:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(php:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(make:*)",
      "Bash(brew:*)",
      "Bash(sed:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(whoami:*)",
      "Bash(date:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(diff:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(open:*)",
      "WebSearch",
      "WebFetch",
      "mcp__laravel-boost__*",
      "mcp__chrome-devtools__*"
    ],
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/vendor/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/.next/**)",
      "Read(**/coverage/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.venv/**)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(echo '$TOOL_INPUT' | jq -r '.file_path // .path // empty'); if [ -z \"$FILE\" ]; then exit 0; fi; case \"$FILE\" in *.env|*.env.*|*.pem|*.key|*.p12|*.pfx) echo \"BLOCKED: Reading sensitive file: $FILE\" >&2; exit 1;; */secrets/*|*/secret/*|*/.ssh/*|*credentials*) echo \"BLOCKED: Reading sensitive path: $FILE\" >&2; exit 1;; */.bashrc|*/.zshrc|*/.gitconfig|*/.bash_profile) echo \"BLOCKED: Reading system dotfile: $FILE\" >&2; exit 1;; *) exit 0;; esac"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(echo '$TOOL_INPUT' | jq -r '.file_path // .path // empty'); if [ -z \"$FILE\" ]; then exit 0; fi; case \"$FILE\" in *.env|*.env.*|*.pem|*.key|*.p12|*.pfx) echo \"BLOCKED: Writing to sensitive file: $FILE\" >&2; exit 1;; */secrets/*|*/secret/*|*/.ssh/*|*credentials*) echo \"BLOCKED: Writing to sensitive path: $FILE\" >&2; exit 1;; */.bashrc|*/.zshrc|*/.gitconfig|*/.bash_profile) echo \"BLOCKED: Writing to system dotfile: $FILE\" >&2; exit 1;; *) exit 0;; esac"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(echo '$TOOL_INPUT' | jq -r '.command // empty'); if [ -z \"$CMD\" ]; then exit 0; fi; if echo \"$CMD\" | grep -qEi 'rm\\s+-rf\\s+/|drop\\s+table|drop\\s+database|kubectl\\s+delete|git\\s+push\\s+--force|git\\s+push\\s+-f|terraform\\s+destroy|cloudformation\\s+delete|mktoken|create.*token|invite.*user|chmod\\s+777'; then echo \"BLOCKED: Destructive or privilege-escalating command detected\" >&2; exit 1; fi; exit 0"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(echo '$TOOL_INPUT' | jq -r '.file_path // .path // empty'); if [ -z \"$FILE\" ] || [ ! -f \"$FILE\" ]; then exit 0; fi; if grep -qEi '(AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|ghp_[0-9a-zA-Z]{36}|glpat-[0-9a-zA-Z_-]{20,}|sk-[0-9a-zA-Z]{32,}|-----BEGIN (RSA |EC |DSA )?PRIVATE KEY-----|password\\s*[:=]\\s*[\"'\\x27][^\"'\\x27]{8,}[\"'\\x27])' \"$FILE\" 2>/dev/null; then echo \"WARNING: Possible secret detected in $FILE. Review before committing.\" >&2; exit 1; fi; exit 0"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"/Users/erik.pach/.dotfiles/config/claude/statusline.sh\""
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "phpstorm-plugin@phpstorm-marketplace": true,
    "agent-browser@agent-browser": true,
    "laravel-simplifier@laravel": true,
    "laravel@laravel": true,
    "caveman@caveman": true,
    "ponytail@ponytail": true,
    "mattpocock-skills@claude-plugins-official": true,
    "cloudflare@cloudflare": true
  },
  "extraKnownMarketplaces": {
    "laravel": {
      "source": {
        "source": "github",
        "repo": "laravel/agent-skills"
      }
    },
    "phpstorm-marketplace": {
      "source": {
        "source": "github",
        "repo": "jetbrains/phpstorm-claude-marketplace"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "fastMode": true,
  "awaySummaryEnabled": false,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "light",
  "autoCompactEnabled": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true
}
